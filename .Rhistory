url <- "https://raw.githubusercontent.com/waldronlab/curatedMetagenomicDataCuration/refs/heads/master/inst/extdata/cMD_data_dictionary.csv"
dd <- readr::read_csv(url)
# Subset to the attributes for MetaHarmonzier
schema <- dd %>% select(schema_cols)
schema_cols <- c("col.name", "col.class", "unique", "required", "scope", "unit.of",
"multiplevalues", "description", "allowedvalues", "static.enum",
"dynamic.enum", "dynamic.enum.property", "delimiter", "separator",
"corpus.type")
schema <- dd %>% select(schema_cols)
